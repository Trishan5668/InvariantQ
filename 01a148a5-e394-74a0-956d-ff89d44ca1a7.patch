+#include "density_matrix.hpp"
+#include <algorithm>
+#include <cmath>
+#include <omp.h>
+
+namespace invariantq {
+
+DensityMatrix::DensityMatrix(size_t num_qubits)
+    : num_qubits_(num_qubits), dim_(1ULL << num_qubits), rho_(dim_ * dim_, complex_t(0.0, 0.0)) {
+    rho_[0] = complex_t(1.0, 0.0);
+}
+
+void DensityMatrix::reset() {
+    std::fill(rho_.begin(), rho_.end(), complex_t(0.0, 0.0));
+    rho_[0] = complex_t(1.0, 0.0);
+}
+
+void DensityMatrix::apply_1q_unitary(size_t target, const complex_t U[4]) {
+    if (target >= num_qubits_) {
+        throw std::out_of_range("Target qubit out of range");
+    }
+
+    const uint64_t m = 1ULL << target;
+    const uint64_t mask_low = m - 1;
+    const uint64_t mask_high = ~mask_low;
+    const uint64_t half_dim = dim_ >> 1;
+
+    std::vector<complex_t> next_rho(dim_ * dim_, complex_t(0.0, 0.0));
+
+    // Left multiplication: rho' = U * rho
+    // For each column c:
+    #pragma omp parallel for schedule(static)
+    for (uint64_t c = 0; c < dim_; ++c) {
+        for (uint64_t i = 0; i < half_dim; ++i) {
+            uint64_t r0 = ((i & mask_high) << 1) | (i & mask_low);
+            uint64_t r1 = r0 | m;
+
+            complex_t a = rho_[r0 * dim_ + c];
+            complex_t b = rho_[r1 * dim_ + c];
+
+            next_rho[r0 * dim_ + c] = U[0] * a + U[1] * b;
+            next_rho[r1 * dim_ + c] = U[2] * a + U[3] * b;
+        }
+    }
+
+    // Right multiplication: rho'' = rho' * U^\dagger
+    // For each row r:
+    complex_t Udag[4] = {
+        std::conj(U[0]), std::conj(U[2]),
+        std::conj(U[1]), std::conj(U[3])
+    };
+
+    #pragma omp parallel for schedule(static)
+    for (uint64_t r = 0; r < dim_; ++r) {
+        for (uint64_t i = 0; i < half_dim; ++i) {
+            uint64_t c0 = ((i & mask_high) << 1) | (i & mask_low);
+            uint64_t c1 = c0 | m;
+
+            complex_t a = next_rho[r * dim_ + c0];
+            complex_t b = next_rho[r * dim_ + c1];
+
+            // row vector [a, b] * Udag
+            rho_[r * dim_ + c0] = a * Udag[0] + b * Udag[2];
+            rho_[r * dim_ + c1] = a * Udag[1] + b * Udag[3];
+        }
+    }
+}
+
+void DensityMatrix::apply_2q_unitary(size_t q0, size_t q1, const complex_t U[16]) {
+    if (q0 >= num_qubits_ || q1 >= num_qubits_ || q0 == q1) {
+        throw std::invalid_argument("Invalid qubit indices");
+    }
+
+    size_t q_low = std::min(q0, q1);
+    size_t q_high = std::max(q0, q1);
+    uint64_t quarter_dim = dim_ >> 2;
+
+    std::vector<complex_t> next_rho(dim_ * dim_, complex_t(0.0, 0.0));
+
+    // Left mult
+    #pragma omp parallel for schedule(static)
+    for (uint64_t c = 0; c < dim_; ++c) {
+        for (uint64_t i = 0; i < quarter_dim; ++i) {
+            uint64_t low = i & ((1ULL << q_low) - 1);
+            uint64_t mid = (i >> q_low) & ((1ULL << (q_high - q_low - 1)) - 1);
+            uint64_t high = i >> (q_high - 1);
+
+            uint64_t i00 = (high << (q_high + 1)) | (mid << (q_low + 1)) | low;
+
+            uint64_t idx[4];
+            idx[0] = i00;
+            idx[1] = i00 | (1ULL << q1);
+            idx[2] = i00 | (1ULL << q0);
+            idx[3] = i00 | (1ULL << q0) | (1ULL << q1);
+
+            complex_t v[4];
+            for (int k = 0; k < 4; ++k) v[k] = rho_[idx[k] * dim_ + c];
+
+            for (int r = 0; r < 4; ++r) {
+                complex_t res = U[r * 4 + 0] * v[0] +
+                                U[r * 4 + 1] * v[1] +
+                                U[r * 4 + 2] * v[2] +
+                                U[r * 4 + 3] * v[3];
+                next_rho[idx[r] * dim_ + c] = res;
+            }
+        }
+    }
+
+    // Compute U^\dagger
+    complex_t Udag[16];
+    for (int r = 0; r < 4; ++r) {
+        for (int col = 0; col < 4; ++col) {
+            Udag[r * 4 + col] = std::conj(U[col * 4 + r]);
+        }
+    }
+
+    // Right mult: rho = next_rho * U^\dagger
+    #pragma omp parallel for schedule(static)
+    for (uint64_t r = 0; r < dim_; ++r) {
+        for (uint64_t i = 0; i < quarter_dim; ++i) {
+            uint64_t low = i & ((1ULL << q_low) - 1);
+            uint64_t mid = (i >> q_low) & ((1ULL << (q_high - q_low - 1)) - 1);
+            uint64_t high = i >> (q_high - 1);
+
+            uint64_t i00 = (high << (q_high + 1)) | (mid << (q_low + 1)) | low;
+
+            uint64_t idx[4];
+            idx[0] = i00;
+            idx[1] = i00 | (1ULL << q1);
+            idx[2] = i00 | (1ULL << q0);
+            idx[3] = i00 | (1ULL << q0) | (1ULL << q1);
+
+            complex_t v[4];
+            for (int k = 0; k < 4; ++k) v[k] = next_rho[r * dim_ + idx[k]];
+
+            for (int col = 0; col < 4; ++col) {
+                complex_t res = v[0] * Udag[0 * 4 + col] +
+                                v[1] * Udag[1 * 4 + col] +
+                                v[2] * Udag[2 * 4 + col] +
+                                v[3] * Udag[3 * 4 + col];
+                rho_[r * dim_ + idx[col]] = res;
+            }
+        }
+    }
+}
+
+void DensityMatrix::apply_1q_kraus(size_t target, const std::vector<Gate1Q>& kraus_ops) {
+    if (target >= num_qubits_) {
+        throw std::out_of_range("Target qubit out of range");
+    }
+
+    std::vector<complex_t> result(dim_ * dim_, complex_t(0.0, 0.0));
+    std::vector<complex_t> initial_rho = rho_;
+
+    for (const auto& k_op : kraus_ops) {
+        rho_ = initial_rho;
+        apply_1q_unitary(target, k_op.m);
+        for (size_t i = 0; i < dim_ * dim_; ++i) {
+            result[i] += rho_[i];
+        }
+    }
+    rho_ = std::move(result);
+}
+
+void DensityMatrix::apply_kraus(const std::vector<size_t>& qubits, const std::vector<std::vector<complex_t>>& kraus_ops, size_t k) {
+    if (k == 1) {
+        std::vector<Gate1Q> ops;
+        for (const auto& vec : kraus_ops) {
+            Gate1Q g;
+            for (int i = 0; i < 4; ++i) g.m[i] = vec[i];
+            ops.push_back(g);
+        }
+        apply_1q_kraus(qubits[0], ops);
+        return;
+    }
+    // For multi-qubit Kraus channels, sum over K_i rho K_i^\dagger
+    // implemented similarly via unitary projection summation
+    std::vector<complex_t> result(dim_ * dim_, complex_t(0.0, 0.0));
+    std::vector<complex_t> initial_rho = rho_;
+
+    for (const auto& k_mat : kraus_ops) {
+        rho_ = initial_rho;
+        if (k == 2) {
+            apply_2q_unitary(qubits[0], qubits[1], k_mat.data());
+        }
+        for (size_t i = 0; i < dim_ * dim_; ++i) {
+            result[i] += rho_[i];
+        }
+    }
+    rho_ = std::move(result);
+}
+
+double DensityMatrix::trace() const {
+    complex_t tr(0.0, 0.0);
+    for (size_t i = 0; i < dim_; ++i) {
+        tr += rho_[i * dim_ + i];
+    }
+    return tr.real();
+}
+
+double DensityMatrix::purity() const {
+    double pur = 0.0;
+    #pragma omp parallel for reduction(+:pur) schedule(static)
+    for (size_t i = 0; i < dim_ * dim_; ++i) {
+        pur += std::norm(rho_[i]);
+    }
+    return pur;
+}
+
+std::vector<double> DensityMatrix::diagonal_probabilities() const {
+    std::vector<double> probs(dim_);
+    for (size_t i = 0; i < dim_; ++i) {
+        probs[i] = std::max(0.0, rho_[i * dim_ + i].real());
+    }
+    return probs;
+}
+
+double DensityMatrix::measure_probability(size_t target, int outcome) const {
+    if (target >= num_qubits_) throw std::out_of_range("Qubit out of range");
+    uint64_t m = 1ULL << target;
+    double p = 0.0;
+    for (uint64_t i = 0; i < dim_; ++i) {
+        int bit = (i & m) ? 1 : 0;
+        if (bit == outcome) {
+            p += rho_[i * dim_ + i].real();
+        }
+    }
+    return std::max(0.0, p);
+}
+
+void DensityMatrix::collapse(size_t target, int outcome) {
+    double p = measure_probability(target, outcome);
+    if (p < 1e-15) throw std::runtime_error("Cannot collapse to zero-probability outcome");
+    double factor = 1.0 / p;
+    uint64_t m = 1ULL << target;
+
+    #pragma omp parallel for schedule(static)
+    for (uint64_t r = 0; r < dim_; ++r) {
+        int bit_r = (r & m) ? 1 : 0;
+        for (uint64_t c = 0; c < dim_; ++c) {
+            int bit_c = (c & m) ? 1 : 0;
+            if (bit_r == outcome && bit_c == outcome) {
+                rho_[r * dim_ + c] *= factor;
+            } else {
+                rho_[r * dim_ + c] = complex_t(0.0, 0.0);
+            }
+        }
+    }
+}
+
+int DensityMatrix::measure(size_t target, double rand_val) {
+    double p0 = measure_probability(target, 0);
+    int outcome = (rand_val < p0) ? 0 : 1;
+    collapse(target, outcome);
+    return outcome;
+}
+
+void DensityMatrix::reset_qubit(size_t target) {
+    if (target >= num_qubits_) throw std::out_of_range("Target qubit out of range");
+    // Project and flip branch 1: K0 = |0><0|, K1 = |0><1|
+    Gate1Q k0, k1;
+    k0.m[0] = complex_t(1.0, 0.0); k0.m[1] = complex_t(0.0, 0.0);
+    k0.m[2] = complex_t(0.0, 0.0); k0.m[3] = complex_t(0.0, 0.0);
+
+    k1.m[0] = complex_t(0.0, 0.0); k1.m[1] = complex_t(1.0, 0.0);
+    k1.m[2] = complex_t(0.0, 0.0); k1.m[3] = complex_t(0.0, 0.0);
+
+    apply_1q_kraus(target, {k0, k1});
+}
+
+std::vector<complex_t> DensityMatrix::partial_trace(const std::vector<size_t>& keep_qubits) const {
+    size_t k = keep_qubits.size();
+    size_t k_dim = 1ULL << k;
+    std::vector<complex_t> reduced(k_dim * k_dim, complex_t(0.0, 0.0));
+
+    std::vector<size_t> traced_qubits;
+    for (size_t q = 0; q < num_qubits_; ++q) {
+        if (std::find(keep_qubits.begin(), keep_qubits.end(), q) == keep_qubits.end()) {
+            traced_qubits.push_back(q);
+        }
+    }
+    size_t t_dim = 1ULL << traced_qubits.size();
+
+    for (uint64_t r = 0; r < k_dim; ++r) {
+        for (uint64_t c = 0; c < k_dim; ++c) {
+            complex_t sum(0.0, 0.0);
+            for (uint64_t env = 0; env < t_dim; ++env) {
+                uint64_t idx_r = 0;
+                uint64_t idx_c = 0;
+
+                for (size_t bit = 0; bit < k; ++bit) {
+                    if ((r >> bit) & 1ULL) idx_r |= (1ULL << keep_qubits[bit]);
+                    if ((c >> bit) & 1ULL) idx_c |= (1ULL << keep_qubits[bit]);
+                }
+                for (size_t bit = 0; bit < traced_qubits.size(); ++bit) {
+                    if ((env >> bit) & 1ULL) {
+                        idx_r |= (1ULL << traced_qubits[bit]);
+                        idx_c |= (1ULL << traced_qubits[bit]);
+                    }
+                }
+
+                sum += rho_[idx_r * dim_ + idx_c];
+            }
+            reduced[r * k_dim + c] = sum;
+        }
+    }
+    return reduced;
+}
+
+double DensityMatrix::von_neumann_entropy() const {
+    // For small dimensions, diagonalize
+    if (dim_ > 64) {
+        // Approximate via diagonal for large systems if needed
+        double s = 0.0;
+        for (size_t i = 0; i < dim_; ++i) {
+            double p = std::max(0.0, rho_[i * dim_ + i].real());
+            if (p > 1e-14) s -= p * std::log2(p);
+        }
+        return s;
+    }
+
+    // Jacobi eigenvalue algorithm on rho_
+    std::vector<std::vector<complex_t>> A(dim_, std::vector<complex_t>(dim_));
+    for (size_t i = 0; i < dim_; ++i) {
+        for (size_t j = 0; j < dim_; ++j) {
+            A[i][j] = rho_[i * dim_ + j];
+        }
+    }
+
+    for (int iter = 0; iter < 120; ++iter) {
+        double max_offdiag = 0.0;
+        size_t p = 0, q = 1;
+        for (size_t i = 0; i < dim_; ++i) {
+            for (size_t j = i + 1; j < dim_; ++j) {
+                double val = std::abs(A[i][j]);
+                if (val > max_offdiag) {
+                    max_offdiag = val;
+                    p = i;
+                    q = j;
+                }
+            }
+        }
+        if (max_offdiag < 1e-13) break;
+
+        double app = A[p][p].real();
+        double aqq = A[q][q].real();
+        complex_t apq = A[p][q];
+
+        double theta = 0.5 * std::atan2(2.0 * std::abs(apq), app - aqq);
+        complex_t phase = apq / std::abs(apq);
+        double c = std::cos(theta);
+        complex_t s = std::sin(theta) * phase;
+
+        for (size_t i = 0; i < dim_; ++i) {
+            if (i != p && i != q) {
+                complex_t aip = A[i][p];
+                complex_t aiq = A[i][q];
+                A[i][p] = c * aip + std::conj(s) * aiq;
+                A[p][i] = std::conj(A[i][p]);
+                A[i][q] = -s * aip + c * aiq;
+                A[q][i] = std::conj(A[i][q]);
+            }
+        }
+        complex_t new_app = c * c * app + std::norm(s) * aqq + 2.0 * (c * std::conj(s) * apq).real();
+        complex_t new_aqq = std::norm(s) * app + c * c * aqq - 2.0 * (c * std::conj(s) * apq).real();
+        A[p][p] = new_app.real();
+        A[q][q] = new_aqq.real();
+        A[p][q] = complex_t(0, 0);
+        A[q][p] = complex_t(0, 0);
+    }
+
+    double entropy = 0.0;
+    for (size_t i = 0; i < dim_; ++i) {
+        double lam = A[i][i].real();
+        if (lam > 1e-14) {
+            entropy -= lam * std::log2(lam);
+        }
+    }
+    return std::max(0.0, entropy);
+}
+
+} // namespace invariantq
diff --git a/core/src/mps.cpp b/core/src/mps.cpp
new file mode 100644
index 0000000..37a93f2
--- /dev/null
+++ b/core/src/mps.cpp
@@ -0,0 +1,399 @@
+#include "mps.hpp"
+#include <cmath>
+#include <algorithm>
+#include <stdexcept>
+#include <iostream>
+
+namespace invariantq {
+
+MPSSimulator::MPSSimulator(size_t num_qubits, size_t max_bond_dim, double svd_cutoff)
+    : num_qubits_(num_qubits),
+      max_bond_dim_(max_bond_dim),
+      svd_cutoff_(svd_cutoff),
+      singular_values_(num_qubits > 1 ? num_qubits - 1 : 0) {
+    reset();
+}
+
+void MPSSimulator::reset() {
+    tensors_.clear();
+    tensors_.reserve(num_qubits_);
+
+    for (size_t i = 0; i < num_qubits_; ++i) {
+        size_t dl = (i == 0) ? 1 : 1;
+        size_t dr = (i == num_qubits_ - 1) ? 1 : 1;
+        MPSTensor t(dl, dr);
+        // State |0>: A[0, 0, 0] = 1, A[0, 1, 0] = 0
+        t.at(0, 0, 0) = complex_t(1.0, 0.0);
+        t.at(0, 1, 0) = complex_t(0.0, 0.0);
+        tensors_.push_back(std::move(t));
+    }
+
+    for (size_t i = 0; i + 1 < num_qubits_; ++i) {
+        singular_values_[i] = {1.0};
+    }
+}
+
+void MPSSimulator::apply_1q_gate(size_t target, const complex_t U[4]) {
+    if (target >= num_qubits_) throw std::out_of_range("Qubit out of range");
+
+    MPSTensor& t = tensors_[target];
+    MPSTensor next_t(t.dl, t.dr);
+
+    for (size_t l = 0; l < t.dl; ++l) {
+        for (size_t r = 0; r < t.dr; ++r) {
+            complex_t a0 = t.at(l, 0, r);
+            complex_t a1 = t.at(l, 1, r);
+
+            next_t.at(l, 0, r) = U[0] * a0 + U[1] * a1;
+            next_t.at(l, 1, r) = U[2] * a0 + U[3] * a1;
+        }
+    }
+    t = std::move(next_t);
+}
+
+void MPSSimulator::apply_2q_gate_adjacent(size_t i, const complex_t U[16]) {
+    if (i + 1 >= num_qubits_) throw std::out_of_range("Adjacent index out of range");
+
+    const MPSTensor& tA = tensors_[i];
+    const MPSTensor& tB = tensors_[i + 1];
+
+    size_t dl = tA.dl;
+    size_t d_mid = tA.dr;
+    size_t dr = tB.dr;
+
+    // Contract tA and tB into Theta: shape (dl, 2, 2, dr)
+    std::vector<complex_t> theta(dl * 4 * dr, complex_t(0.0, 0.0));
+
+    for (size_t l = 0; l < dl; ++l) {
+        for (size_t s0 = 0; s0 < 2; ++s0) {
+            for (size_t s1 = 0; s1 < 2; ++s1) {
+                for (size_t r = 0; r < dr; ++r) {
+                    complex_t sum(0.0, 0.0);
+                    for (size_t m = 0; m < d_mid; ++m) {
+                        sum += tA.at(l, s0, m) * tB.at(m, s1, r);
+                    }
+                    size_t idx = ((l * 2 + s0) * 2 + s1) * dr + r;
+                    theta[idx] = sum;
+                }
+            }
+        }
+    }
+
+    // Apply 4x4 unitary gate
+    std::vector<complex_t> theta_prime(dl * 4 * dr, complex_t(0.0, 0.0));
+    for (size_t l = 0; l < dl; ++l) {
+        for (size_t r = 0; r < dr; ++r) {
+            complex_t v[4];
+            for (size_t s0 = 0; s0 < 2; ++s0) {
+                for (size_t s1 = 0; s1 < 2; ++s1) {
+                    size_t in_idx = ((l * 2 + s0) * 2 + s1) * dr + r;
+                    v[s0 * 2 + s1] = theta[in_idx];
+                }
+            }
+
+            for (size_t out_s = 0; out_s < 4; ++out_s) {
+                complex_t acc(0.0, 0.0);
+                for (size_t in_s = 0; in_s < 4; ++in_s) {
+                    acc += U[out_s * 4 + in_s] * v[in_s];
+                }
+                size_t s0_prime = out_s / 2;
+                size_t s1_prime = out_s % 2;
+                size_t out_idx = ((l * 2 + s0_prime) * 2 + s1_prime) * dr + r;
+                theta_prime[out_idx] = acc;
+            }
+        }
+    }
+
+    decompose_two_site(i, theta_prime, dl, dr);
+}
+
+void MPSSimulator::decompose_two_site(size_t i, const std::vector<complex_t>& theta, size_t dl, size_t dr) {
+    size_t rows = dl * 2;
+    size_t cols = 2 * dr;
+
+    // Build matrix M of size rows x cols
+    std::vector<std::vector<complex_t>> M(rows, std::vector<complex_t>(cols));
+    for (size_t l = 0; l < dl; ++l) {
+        for (size_t s0 = 0; s0 < 2; ++s0) {
+            size_t r_idx = l * 2 + s0;
+            for (size_t s1 = 0; s1 < 2; ++s1) {
+                for (size_t r = 0; r < dr; ++r) {
+                    size_t c_idx = s1 * dr + r;
+                    size_t th_idx = ((l * 2 + s0) * 2 + s1) * dr + r;
+                    M[r_idx][c_idx] = theta[th_idx];
+                }
+            }
+        }
+    }
+
+    // Compute H = M * M^\dagger (rows x rows)
+    std::vector<std::vector<complex_t>> H(rows, std::vector<complex_t>(rows, complex_t(0, 0)));
+    for (size_t r1 = 0; r1 < rows; ++r1) {
+        for (size_t r2 = 0; r2 < rows; ++r2) {
+            complex_t sum(0, 0);
+            for (size_t c = 0; c < cols; ++c) {
+                sum += M[r1][c] * std::conj(M[r2][c]);
+            }
+            H[r1][r2] = sum;
+        }
+    }
+
+    // Jacobi diagonalization of H to get U and singular values^2
+    std::vector<std::vector<complex_t>> U_mat(rows, std::vector<complex_t>(rows, complex_t(0, 0)));
+    for (size_t k = 0; k < rows; ++k) U_mat[k][k] = complex_t(1, 0);
+
+    for (int iter = 0; iter < 80; ++iter) {
+        double max_val = 0.0;
+        size_t p = 0, q = 1;
+        for (size_t r1 = 0; r1 < rows; ++r1) {
+            for (size_t r2 = r1 + 1; r2 < rows; ++r2) {
+                double val = std::abs(H[r1][r2]);
+                if (val > max_val) {
+                    max_val = val;
+                    p = r1;
+                    q = r2;
+                }
+            }
+        }
+        if (max_val < 1e-13) break;
+
+        double app = H[p][p].real();
+        double aqq = H[q][q].real();
+        complex_t apq = H[p][q];
+
+        double theta_ang = 0.5 * std::atan2(2.0 * std::abs(apq), app - aqq);
+        complex_t phase = apq / std::abs(apq);
+        double c = std::cos(theta_ang);
+        complex_t s = std::sin(theta_ang) * phase;
+
+        for (size_t k = 0; k < rows; ++k) {
+            if (k != p && k != q) {
+                complex_t hip = H[k][p];
+                complex_t hiq = H[k][q];
+                H[k][p] = c * hip + std::conj(s) * hiq;
+                H[p][k] = std::conj(H[k][p]);
+                H[k][q] = -s * hip + c * hiq;
+                H[q][k] = std::conj(H[k][q]);
+            }
+        }
+        complex_t new_app = c * c * app + std::norm(s) * aqq + 2.0 * (c * std::conj(s) * apq).real();
+        complex_t new_aqq = std::norm(s) * app + c * c * aqq - 2.0 * (c * std::conj(s) * apq).real();
+        H[p][p] = new_app.real();
+        H[q][q] = new_aqq.real();
+        H[p][q] = complex_t(0, 0);
+        H[q][p] = complex_t(0, 0);
+
+        for (size_t k = 0; k < rows; ++k) {
+            complex_t ukp = U_mat[k][p];
+            complex_t ukq = U_mat[k][q];
+            U_mat[k][p] = c * ukp + std::conj(s) * ukq;
+            U_mat[k][q] = -s * ukp + c * ukq;
+        }
+    }
+
+    // Extract eigenvalues and sort
+    struct EigPair {
+        double val;
+        size_t idx;
+    };
+    std::vector<EigPair> eigs(rows);
+    for (size_t k = 0; k < rows; ++k) {
+        eigs[k] = {std::max(0.0, H[k][k].real()), k};
+    }
+    std::sort(eigs.begin(), eigs.end(), [](const EigPair& a, const EigPair& b) {
+        return a.val > b.val;
+    });
+
+    // Determine new bond dimension
+    size_t new_d = 0;
+    for (size_t k = 0; k < rows; ++k) {
+        double s_val = std::sqrt(eigs[k].val);
+        if (s_val >= svd_cutoff_ || new_d == 0) {
+            new_d++;
+            if (new_d >= max_bond_dim_ || new_d >= cols) break;
+        }
+    }
+    new_d = std::max<size_t>(1, std::min({new_d, max_bond_dim_, cols, rows}));
+
+    std::vector<double> svs(new_d);
+    double sum_sq = 0.0;
+    for (size_t k = 0; k < new_d; ++k) {
+        svs[k] = std::sqrt(eigs[k].val);
+        sum_sq += svs[k] * svs[k];
+    }
+    // Normalize singular values
+    if (sum_sq > 0.0) {
+        double norm_factor = 1.0 / std::sqrt(sum_sq);
+        for (size_t k = 0; k < new_d; ++k) svs[k] *= norm_factor;
+    }
+    singular_values_[i] = svs;
+
+    // Construct new tensor A[i] (shape: dl x 2 x new_d)
+    MPSTensor new_tA(dl, new_d);
+    for (size_t l = 0; l < dl; ++l) {
+        for (size_t s0 = 0; s0 < 2; ++s0) {
+            size_t r_idx = l * 2 + s0;
+            for (size_t k = 0; k < new_d; ++k) {
+                size_t col_in_U = eigs[k].idx;
+                new_tA.at(l, s0, k) = U_mat[r_idx][col_in_U];
+            }
+        }
+    }
+
+    // Construct new tensor A[i+1] (shape: new_d x 2 x dr) from S * V^\dagger
+    // V^\dagger_k = (1 / svs[k]) * U_k^\dagger * M, so S * V^\dagger = U_k^\dagger * M
+    MPSTensor new_tB(new_d, dr);
+    for (size_t k = 0; k < new_d; ++k) {
+        size_t col_in_U = eigs[k].idx;
+        for (size_t s1 = 0; s1 < 2; ++s1) {
+            for (size_t r = 0; r < dr; ++r) {
+                size_t c_idx = s1 * dr + r;
+                complex_t sum(0, 0);
+                for (size_t r_idx = 0; r_idx < rows; ++r_idx) {
+                    sum += std::conj(U_mat[r_idx][col_in_U]) * M[r_idx][c_idx];
+                }
+                new_tB.at(k, s1, r) = sum;
+            }
+        }
+    }
+
+    tensors_[i] = std::move(new_tA);
+    tensors_[i + 1] = std::move(new_tB);
+}
+
+void MPSSimulator::apply_2q_gate(size_t q0, size_t q1, const complex_t U[16]) {
+    if (q0 == q1 || q0 >= num_qubits_ || q1 >= num_qubits_) {
+        throw std::invalid_argument("Invalid 2-qubit indices");
+    }
+
+    if (q0 + 1 == q1) {
+        apply_2q_gate_adjacent(q0, U);
+        return;
+    }
+    if (q1 + 1 == q0) {
+        // Swap inputs to match unitary basis
+        complex_t U_swapped[16];
+        for (int r = 0; r < 4; ++r) {
+            for (int c = 0; c < 4; ++c) {
+                int r_sw = ((r & 1) << 1) | ((r >> 1) & 1);
+                int c_sw = ((c & 1) << 1) | ((c >> 1) & 1);
+                U_swapped[r_sw * 4 + c_sw] = U[r * 4 + c];
+            }
+        }
+        apply_2q_gate_adjacent(q1, U_swapped);
+        return;
+    }
+
+    // Long-range gate: swap path
+    size_t low = std::min(q0, q1);
+    size_t high = std::max(q0, q1);
+    Gate2Q swap_gate = gate_swap();
+
+    // Swap adjacent pairs until target is adjacent
+    for (size_t k = low; k + 1 < high; ++k) {
+        apply_2q_gate_adjacent(k, swap_gate.m);
+    }
+
+    if (q0 < q1) {
+        apply_2q_gate_adjacent(high - 1, U);
+    } else {
+        complex_t U_swapped[16];
+        for (int r = 0; r < 4; ++r) {
+            for (int c = 0; c < 4; ++c) {
+                int r_sw = ((r & 1) << 1) | ((r >> 1) & 1);
+                int c_sw = ((c & 1) << 1) | ((c >> 1) & 1);
+                U_swapped[r_sw * 4 + c_sw] = U[r * 4 + c];
+            }
+        }
+        apply_2q_gate_adjacent(high - 1, U_swapped);
+    }
+
+    // Swap back
+    for (size_t k = high - 1; k > low; --k) {
+        apply_2q_gate_adjacent(k - 1, swap_gate.m);
+    }
+}
+
+double MPSSimulator::entanglement_entropy(size_t bond_idx) const {
+    if (bond_idx >= singular_values_.size()) return 0.0;
+    const auto& svs = singular_values_[bond_idx];
+
+    double entropy = 0.0;
+    for (double s : svs) {
+        double p = s * s;
+        if (p > 1e-14) {
+            entropy -= p * std::log2(p);
+        }
+    }
+    return std::max(0.0, entropy);
+}
+
+std::vector<double> MPSSimulator::get_bond_dimensions() const {
+    std::vector<double> dims;
+    for (const auto& t : tensors_) {
+        dims.push_back(static_cast<double>(t.dr));
+    }
+    return dims;
+}
+
+std::vector<complex_t> MPSSimulator::to_statevector() const {
+    // Sequentially contract from left to right
+    // Start with site 0: vector of shape (2, d1)
+    size_t cur_dim = 2;
+    size_t cur_bond = tensors_[0].dr;
+    std::vector<complex_t> state(cur_dim * cur_bond);
+
+    for (size_t s = 0; s < 2; ++s) {
+        for (size_t r = 0; r < cur_bond; ++r) {
+            state[s * cur_bond + r] = tensors_[0].at(0, s, r);
+        }
+    }
+
+    for (size_t i = 1; i < num_qubits_; ++i) {
+        const MPSTensor& t = tensors_[i];
+        size_t next_dim = cur_dim * 2;
+        size_t next_bond = t.dr;
+        std::vector<complex_t> next_state(next_dim * next_bond, complex_t(0, 0));
+
+        for (size_t prefix = 0; prefix < cur_dim; ++prefix) {
+            for (size_t s = 0; s < 2; ++s) {
+                size_t out_prefix = prefix * 2 + s;
+                for (size_t r = 0; r < next_bond; ++r) {
+                    complex_t sum(0, 0);
+                    for (size_t m = 0; m < cur_bond; ++m) {
+                        sum += state[prefix * cur_bond + m] * t.at(m, s, r);
+                    }
+                    next_state[out_prefix * next_bond + r] = sum;
+                }
+            }
+        }
+        state = std::move(next_state);
+        cur_dim = next_dim;
+        cur_bond = next_bond;
+    }
+    return state;
+}
+
+double MPSSimulator::measure_probability(size_t target, int outcome) {
+    std::vector<complex_t> sv = to_statevector();
+    uint64_t m = 1ULL << (num_qubits_ - 1 - target);
+    double p = 0.0;
+    for (size_t i = 0; i < sv.size(); ++i) {
+        int bit = (i & m) ? 1 : 0;
+        if (bit == outcome) p += std::norm(sv[i]);
+    }
+    return p;
+}
+
+int MPSSimulator::measure(size_t target, double rand_val) {
+    double p0 = measure_probability(target, 0);
+    int outcome = (rand_val < p0) ? 0 : 1;
+    // Project and normalize site target
+    complex_t proj[4] = {0, 0, 0, 0};
+    if (outcome == 0) proj[0] = 1.0;
+    else proj[3] = 1.0;
+    apply_1q_gate(target, proj);
+    return outcome;
+}
+
+} // namespace invariantq
diff --git a/core/src/stabilizer.cpp b/core/src/stabilizer.cpp
new file mode 100644
index 0000000..daa5647
--- /dev/null
+++ b/core/src/stabilizer.cpp
@@ -0,0 +1,252 @@
+#include "stabilizer.hpp"
+#include <sstream>
+#include <iostream>
+
+namespace invariantq {
+
+StabilizerSimulator::StabilizerSimulator(size_t num_qubits)
+    : num_qubits_(num_qubits),
+      rows_(2 * num_qubits),
+      x_(rows_ * num_qubits, 0),
+      z_(rows_ * num_qubits, 0),
+      r_(rows_, 0) {
+    reset();
+}
+
+void StabilizerSimulator::reset() {
+    std::fill(x_.begin(), x_.end(), 0);
+    std::fill(z_.begin(), z_.end(), 0);
+    std::fill(r_.begin(), r_.end(), 0);
+
+    // Initial state |0...0>
+    // Destabilizers: R_i = X_i
+    for (size_t i = 0; i < num_qubits_; ++i) {
+        x_[i * num_qubits_ + i] = 1;
+    }
+    // Stabilizers: R_{n+i} = Z_i
+    for (size_t i = 0; i < num_qubits_; ++i) {
+        z_[(num_qubits_ + i) * num_qubits_ + i] = 1;
+    }
+}
+
+int StabilizerSimulator::g_func(uint8_t x1, uint8_t z1, uint8_t x2, uint8_t z2) const {
+    if (x1 == 0 && z1 == 0) return 0;
+    if (x1 == 1 && z1 == 1) {
+        // Y * P
+        if (x2 == 1 && z2 == 0) return 1;  // Y * X = -i Z
+        if (x2 == 0 && z2 == 1) return -1; // Y * Z = i X
+        return 0;
+    }
+    if (x1 == 1 && z1 == 0) {
+        // X * P
+        if (x2 == 0 && z2 == 1) return 1;  // X * Z = -i Y
+        if (x2 == 1 && z2 == 1) return -1; // X * Y = i Z
+        return 0;
+    }
+    if (x1 == 0 && z1 == 1) {
+        // Z * P
+        if (x2 == 1 && z2 == 1) return 1;  // Z * Y = -i X
+        if (x2 == 1 && z2 == 0) return -1; // Z * X = i Y
+        return 0;
+    }
+    return 0;
+}
+
+void StabilizerSimulator::row_mult(size_t target_row, size_t source_row) {
+    int sum_g = 0;
+    for (size_t j = 0; j < num_qubits_; ++j) {
+        uint8_t x1 = x_[target_row * num_qubits_ + j];
+        uint8_t z1 = z_[target_row * num_qubits_ + j];
+        uint8_t x2 = x_[source_row * num_qubits_ + j];
+        uint8_t z2 = z_[source_row * num_qubits_ + j];
+        sum_g += g_func(x1, z1, x2, z2);
+    }
+
+    int total = 2 * r_[target_row] + 2 * r_[source_row] + sum_g;
+    total = ((total % 4) + 4) % 4;
+
+    if (total == 0) {
+        r_[target_row] = 0;
+    } else if (total == 2) {
+        r_[target_row] = 1;
+    } else {
+        // Total should always be 0 or 2 for valid Pauli products
+        r_[target_row] = 0;
+    }
+
+    for (size_t j = 0; j < num_qubits_; ++j) {
+        x_[target_row * num_qubits_ + j] ^= x_[source_row * num_qubits_ + j];
+        z_[target_row * num_qubits_ + j] ^= z_[source_row * num_qubits_ + j];
+    }
+}
+
+void StabilizerSimulator::apply_h(size_t a) {
+    if (a >= num_qubits_) throw std::out_of_range("Qubit out of range");
+    for (size_t i = 0; i < rows_; ++i) {
+        uint8_t x_ia = x_[i * num_qubits_ + a];
+        uint8_t z_ia = z_[i * num_qubits_ + a];
+        r_[i] ^= (x_ia & z_ia);
+        x_[i * num_qubits_ + a] = z_ia;
+        z_[i * num_qubits_ + a] = x_ia;
+    }
+}
+
+void StabilizerSimulator::apply_s(size_t a) {
+    if (a >= num_qubits_) throw std::out_of_range("Qubit out of range");
+    for (size_t i = 0; i < rows_; ++i) {
+        uint8_t x_ia = x_[i * num_qubits_ + a];
+        uint8_t z_ia = z_[i * num_qubits_ + a];
+        r_[i] ^= (x_ia & z_ia);
+        z_[i * num_qubits_ + a] ^= x_ia;
+    }
+}
+
+void StabilizerSimulator::apply_sdg(size_t a) {
+    // S^\dagger = S * S * S
+    apply_s(a);
+    apply_s(a);
+    apply_s(a);
+}
+
+void StabilizerSimulator::apply_cnot(size_t a, size_t b) {
+    if (a >= num_qubits_ || b >= num_qubits_ || a == b) {
+        throw std::invalid_argument("Invalid CNOT indices");
+    }
+    for (size_t i = 0; i < rows_; ++i) {
+        uint8_t x_ia = x_[i * num_qubits_ + a];
+        uint8_t z_ia = z_[i * num_qubits_ + a];
+        uint8_t x_ib = x_[i * num_qubits_ + b];
+        uint8_t z_ib = z_[i * num_qubits_ + b];
+
+        r_[i] ^= (x_ia & z_ib & (x_ib ^ z_ia ^ 1));
+        x_[i * num_qubits_ + b] ^= x_ia;
+        z_[i * num_qubits_ + a] ^= z_ib;
+    }
+}
+
+void StabilizerSimulator::apply_cz(size_t a, size_t b) {
+    apply_h(b);
+    apply_cnot(a, b);
+    apply_h(b);
+}
+
+void StabilizerSimulator::apply_swap(size_t a, size_t b) {
+    apply_cnot(a, b);
+    apply_cnot(b, a);
+    apply_cnot(a, b);
+}
+
+void StabilizerSimulator::apply_x(size_t a) {
+    apply_h(a);
+    apply_z(a);
+    apply_h(a);
+}
+
+void StabilizerSimulator::apply_z(size_t a) {
+    if (a >= num_qubits_) throw std::out_of_range("Qubit out of range");
+    for (size_t i = 0; i < rows_; ++i) {
+        r_[i] ^= x_[i * num_qubits_ + a];
+    }
+}
+
+void StabilizerSimulator::apply_y(size_t a) {
+    apply_z(a);
+    apply_x(a);
+}
+
+int StabilizerSimulator::measure(size_t a, double rand_val) {
+    if (a >= num_qubits_) throw std::out_of_range("Qubit out of range");
+
+    // Check if there is p in [n, 2n) such that x_[p * n + a] == 1
+    size_t p = 2 * num_qubits_;
+    for (size_t i = num_qubits_; i < rows_; ++i) {
+        if (x_[i * num_qubits_ + a] == 1) {
+            p = i;
+            break;
+        }
+    }
+
+    if (p < rows_) {
+        // Case 1: Random outcome
+        for (size_t i = 0; i < rows_; ++i) {
+            if (i != p && x_[i * num_qubits_ + a] == 1) {
+                row_mult(i, p);
+            }
+        }
+
+        // Copy row p to row p - num_qubits_
+        size_t p_destab = p - num_qubits_;
+        for (size_t j = 0; j < num_qubits_; ++j) {
+            x_[p_destab * num_qubits_ + j] = x_[p * num_qubits_ + j];
+            z_[p_destab * num_qubits_ + j] = z_[p * num_qubits_ + j];
+        }
+        r_[p_destab] = r_[p];
+
+        // Set row p to Z_a
+        for (size_t j = 0; j < num_qubits_; ++j) {
+            x_[p * num_qubits_ + j] = 0;
+            z_[p * num_qubits_ + j] = 0;
+        }
+        z_[p * num_qubits_ + a] = 1;
+
+        int outcome = (rand_val < 0.5) ? 0 : 1;
+        r_[p] = outcome;
+        return outcome;
+    } else {
+        // Case 2: Deterministic outcome
+        // Create scratch row: starts with identity (all 0, phase 0)
+        std::vector<uint8_t> acc_x(num_qubits_, 0);
+        std::vector<uint8_t> acc_z(num_qubits_, 0);
+        uint8_t acc_r = 0;
+
+        for (size_t i = 0; i < num_qubits_; ++i) {
+            if (x_[i * num_qubits_ + a] == 1) {
+                size_t src = num_qubits_ + i;
+                int sum_g = 0;
+                for (size_t j = 0; j < num_qubits_; ++j) {
+                    sum_g += g_func(acc_x[j], acc_z[j], x_[src * num_qubits_ + j], z_[src * num_qubits_ + j]);
+                }
+                int total = 2 * acc_r + 2 * r_[src] + sum_g;
+                total = ((total % 4) + 4) % 4;
+                acc_r = (total == 2) ? 1 : 0;
+
+                for (size_t j = 0; j < num_qubits_; ++j) {
+                    acc_x[j] ^= x_[src * num_qubits_ + j];
+                    acc_z[j] ^= z_[src * num_qubits_ + j];
+                }
+            }
+        }
+        return acc_r;
+    }
+}
+
+void StabilizerSimulator::reset_qubit(size_t a, double rand_val) {
+    int outcome = measure(a, rand_val);
+    if (outcome == 1) {
+        apply_x(a);
+    }
+}
+
+std::string StabilizerSimulator::get_pauli_row(size_t row_idx) const {
+    std::string s = (r_[row_idx] == 1) ? "-" : "+";
+    for (size_t j = 0; j < num_qubits_; ++j) {
+        uint8_t xj = x_[row_idx * num_qubits_ + j];
+        uint8_t zj = z_[row_idx * num_qubits_ + j];
+        if (xj == 0 && zj == 0) s += "I";
+        else if (xj == 1 && zj == 0) s += "X";
+        else if (xj == 1 && zj == 1) s += "Y";
+        else s += "Z";
+    }
+    return s;
+}
+
+std::string StabilizerSimulator::to_string() const {
+    std::ostringstream oss;
+    oss << "Stabilizers:\n";
+    for (size_t i = num_qubits_; i < rows_; ++i) {
+        oss << "  " << get_pauli_row(i) << "\n";
+    }
+    return oss.str();
+}
