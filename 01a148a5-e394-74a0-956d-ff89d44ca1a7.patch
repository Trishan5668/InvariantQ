+++ b/invariantq/verification/fault_injection.py
@@ -0,0 +1,72 @@
+"""
+Fault Injection and Flaw Detection Suite.
+Intentionally seeds mutations (e.g. phase corruption, off-by-one qubit indexing, broken Kraus channels)
+and demonstrates that Metamorphic and Differential test suites reliably detect and flag them.
+"""
+
+from __future__ import annotations
+from typing import Dict, Any, Tuple
+import numpy as np
+
+from ..ir.qir import CircuitIR, GateOp, QWire
+from .metamorphic import MetamorphicTester
+from ..noise.cptp_validator import validate_cptp
+
+class FaultInjectionTester:
+    def __init__(self):
+        self.meta_tester = MetamorphicTester()
+
+    def test_corrupted_gate_detection(self) -> Dict[str, Any]:
+        """
+        Seeds an erroneous gate implementation (e.g. corrupted H gate whose inverse does not equal identity)
+        and verifies that metamorphic testing flags it as a failure.
+        """
+        # Baseline healthy Bell circuit with H-H identity relation
+        healthy = CircuitIR("healthy")
+        healthy.add_qubit_register("q", 1)
+        w0 = QWire("q", 0)
+        # Invariant: H applied twice is Identity
+        healthy.add_op(GateOp(name="h", qubits=[w0]))
+        healthy.add_op(GateOp(name="h", qubits=[w0]))
+
+        res_healthy = self.meta_tester.sim.run(healthy, shots=500)
+        # Should be |0> with probability 1.0
+        p0_healthy = res_healthy.probabilities.get("0", 0.0)
+        healthy_passed = abs(p0_healthy - 1.0) < 1e-4
+
+        # Flawed circuit: corrupted H gate where H_corrupted * H != I
+        flawed = CircuitIR("flawed")
+        flawed.add_qubit_register("q", 1)
+        corrupted_mat = np.array([[0.5, 0.5], [0.8, -0.2]], dtype=np.complex128)
+        flawed.add_op(GateOp(name="h_corrupted", qubits=[w0], matrix=corrupted_mat))
+        # Appending normal H
+        flawed.add_op(GateOp(name="h", qubits=[w0]))
+
+        res_flawed = self.meta_tester.sim.run(flawed, shots=500)
+        p0_flawed = res_flawed.probabilities.get("0", 0.0)
+        flawed_passed = abs(p0_flawed - 1.0) < 1e-4
+
+        bug_caught = (healthy_passed is True) and (flawed_passed is False)
+
+        return {
+            "healthy_passed": healthy_passed,
+            "flawed_passed": flawed_passed,
+            "bug_caught": bug_caught,
+            "flawed_details": f"Corrupted gate output probability P(|0>) was {p0_flawed:.4f} instead of 1.0"
+        }
+
+    def test_broken_cptp_channel_detection(self) -> Dict[str, Any]:
+        r"""
+        Seeds a broken non-CPTP Kraus channel (missing operator, sum K^\dagger K != I)
+        and verifies that CPTP validator catches it.
+        """
+        # Broken Kraus channel: K_0 = [[0.8, 0], [0, 0.8]] without K_1
+        broken_kraus = [0.8 * np.eye(2, dtype=np.complex128)]
+        res = validate_cptp(broken_kraus)
+
+        return {
+            "is_cptp": res["is_cptp"],
+            "is_trace_preserving": res["is_trace_preserving"],
+            "bug_caught": not res["is_cptp"],
+            "residual": res["trace_preserving_residual"]
+        }
diff --git a/invariantq/verification/independent_reference.py b/invariantq/verification/independent_reference.py
new file mode 100644
index 0000000..e79c251
--- /dev/null
+++ b/invariantq/verification/independent_reference.py
@@ -0,0 +1,73 @@
+"""
+Independent Reference Quantum State Engine for Differential Cross-Validation.
+Evaluates quantum circuits using pure NumPy einsum multi-linear algebra contractions
+independently of the C++ numerical kernels, MPS, or Stabilizer engines.
+"""
+
+from __future__ import annotations
+import math
+from typing import List, Dict, Any, Tuple
+import numpy as np
+from ..ir.qir import CircuitIR, GateOp
+
+class IndependentTensorContractionRef:
+    """
+    Independent reference simulation engine implemented entirely via
+    NumPy multi-linear algebra einsum tensor contractions.
+    Serves as an independent cross-check for C++ numerical kernels.
+    """
+    def __init__(self, num_qubits: int):
+        self.num_qubits = num_qubits
+        self.state_tensor = np.zeros([2] * num_qubits, dtype=np.complex128)
+        self.state_tensor[tuple([0] * num_qubits)] = 1.0
+
+    def apply_gate(self, matrix: np.ndarray, qubits: List[int]):
+        k = len(qubits)
+        n = self.num_qubits
+        out_letters = [chr(ord('a') + i) for i in range(n)]
+
+        if k == 1:
+            q = qubits[0]
+            in_letters = list(out_letters)
+            in_letters[q] = 'Z'
+            eq = f"{out_letters[q]}Z,{''.join(in_letters)}->{''.join(out_letters)}"
+            self.state_tensor = np.einsum(eq, matrix, self.state_tensor)
+
+        elif k == 2:
+            q0, q1 = qubits[0], qubits[1]
+            u_4d = matrix.reshape((2, 2, 2, 2))
+            in_letters = list(out_letters)
+            in_letters[q0] = 'Y'
+            in_letters[q1] = 'Z'
+            eq = f"{out_letters[q0]}{out_letters[q1]}YZ,{''.join(in_letters)}->{''.join(out_letters)}"
+            self.state_tensor = np.einsum(eq, u_4d, self.state_tensor)
+
+        elif k == 3:
+            q0, q1, q2 = qubits[0], qubits[1], qubits[2]
+            u_6d = matrix.reshape((2, 2, 2, 2, 2, 2))
+            in_letters = list(out_letters)
+            in_letters[q0] = 'X'
+            in_letters[q1] = 'Y'
+            in_letters[q2] = 'Z'
+            eq = f"{out_letters[q0]}{out_letters[q1]}{out_letters[q2]}XYZ,{''.join(in_letters)}->{''.join(out_letters)}"
+            self.state_tensor = np.einsum(eq, u_6d, self.state_tensor)
+
+    def get_statevector(self) -> np.ndarray:
+        return self.state_tensor.flatten(order='F')
+
+    def get_probabilities(self) -> np.ndarray:
+        sv = self.get_statevector()
+        return np.abs(sv) ** 2
+
+
+def run_independent_reference(circuit: CircuitIR) -> np.ndarray:
+    """
+    Executes a CircuitIR using the independent NumPy tensor contraction engine
+    and returns the resulting length-2^n statevector.
+    """
+    ref = IndependentTensorContractionRef(circuit.num_qubits)
+    for op in circuit.ops:
+        if isinstance(op, GateOp) and op.matrix is not None:
+            qubits = [circuit.get_qubit_index(q) for q in op.qubits]
+            ref.apply_gate(op.matrix, qubits)
+    return ref.get_statevector()
