+    size_t dim_;
+    std::vector<complex_t> amplitudes_;
+};
+
+} // namespace invariantq
diff --git a/core/include/types.hpp b/core/include/types.hpp
new file mode 100644
index 0000000..699c369
--- /dev/null
+++ b/core/include/types.hpp
@@ -0,0 +1,128 @@
+#pragma once
+
+#include <complex>
+#include <vector>
+#include <cstdint>
+#include <string>
+#include <cmath>
+#include <iostream>
+
+namespace invariantq {
+
+using complex_t = std::complex<double>;
+
+constexpr double PI = 3.14159265358979323846;
+
+struct Gate1Q {
+    complex_t m[4]; // Row-major: m[0]=00, m[1]=01, m[2]=10, m[3]=11
+};
+
+struct Gate2Q {
+    complex_t m[16]; // Row-major 4x4
+};
+
+// Standard Pauli & Single-Qubit Gates
+inline Gate1Q gate_identity() {
+    return {complex_t(1,0), complex_t(0,0), complex_t(0,0), complex_t(1,0)};
+}
+
+inline Gate1Q gate_pauli_x() {
+    return {complex_t(0,0), complex_t(1,0), complex_t(1,0), complex_t(0,0)};
+}
+
+inline Gate1Q gate_pauli_y() {
+    return {complex_t(0,0), complex_t(0,-1), complex_t(0,1), complex_t(0,0)};
+}
+
+inline Gate1Q gate_pauli_z() {
+    return {complex_t(1,0), complex_t(0,0), complex_t(0,0), complex_t(-1,0)};
+}
+
+inline Gate1Q gate_hadamard() {
+    double inv = 1.0 / std::sqrt(2.0);
+    return {complex_t(inv,0), complex_t(inv,0), complex_t(inv,0), complex_t(-inv,0)};
+}
+
+inline Gate1Q gate_s() {
+    return {complex_t(1,0), complex_t(0,0), complex_t(0,0), complex_t(0,1)};
+}
+
+inline Gate1Q gate_sdg() {
+    return {complex_t(1,0), complex_t(0,0), complex_t(0,0), complex_t(0,-1)};
+}
+
+inline Gate1Q gate_t() {
+    double inv = 1.0 / std::sqrt(2.0);
+    return {complex_t(1,0), complex_t(0,0), complex_t(0,0), complex_t(inv, inv)};
+}
+
+inline Gate1Q gate_tdg() {
+    double inv = 1.0 / std::sqrt(2.0);
+    return {complex_t(1,0), complex_t(0,0), complex_t(0,0), complex_t(inv, -inv)};
+}
+
+inline Gate1Q gate_rx(double theta) {
+    double c = std::cos(theta / 2.0);
+    double s = std::sin(theta / 2.0);
+    return {complex_t(c, 0), complex_t(0, -s), complex_t(0, -s), complex_t(c, 0)};
+}
+
+inline Gate1Q gate_ry(double theta) {
+    double c = std::cos(theta / 2.0);
+    double s = std::sin(theta / 2.0);
+    return {complex_t(c, 0), complex_t(-s, 0), complex_t(s, 0), complex_t(c, 0)};
+}
+
+inline Gate1Q gate_rz(double theta) {
+    double c = std::cos(theta / 2.0);
+    double s = std::sin(theta / 2.0);
+    return {complex_t(c, -s), complex_t(0, 0), complex_t(0, 0), complex_t(c, s)};
+}
+
+inline Gate1Q gate_u3(double theta, double phi, double lambda) {
+    double c = std::cos(theta / 2.0);
+    double s = std::sin(theta / 2.0);
+    complex_t exp_phi(std::cos(phi), std::sin(phi));
+    complex_t exp_lam(std::cos(lambda), std::sin(lambda));
+    complex_t exp_phi_lam(std::cos(phi + lambda), std::sin(phi + lambda));
+
+    return {
+        complex_t(c, 0),
+        -exp_lam * complex_t(s, 0),
+        exp_phi * complex_t(s, 0),
+        exp_phi_lam * complex_t(c, 0)
+    };
+}
+
+// 2-Qubit Gates
+inline Gate2Q gate_cnot() {
+    Gate2Q g;
+    std::fill(std::begin(g.m), std::end(g.m), complex_t(0,0));
+    g.m[0]  = complex_t(1,0); // 00 -> 00
+    g.m[5]  = complex_t(1,0); // 01 -> 01
+    g.m[11] = complex_t(1,0); // 10 -> 11
+    g.m[14] = complex_t(1,0); // 11 -> 10
+    return g;
+}
+
+inline Gate2Q gate_cz() {
+    Gate2Q g;
+    std::fill(std::begin(g.m), std::end(g.m), complex_t(0,0));
+    g.m[0]  = complex_t(1,0); // 00 -> 00
+    g.m[5]  = complex_t(1,0); // 01 -> 01
+    g.m[10] = complex_t(1,0); // 10 -> 10
+    g.m[15] = complex_t(-1,0);// 11 -> -11
+    return g;
+}
+
+inline Gate2Q gate_swap() {
+    Gate2Q g;
+    std::fill(std::begin(g.m), std::end(g.m), complex_t(0,0));
+    g.m[0]  = complex_t(1,0);
+    g.m[6]  = complex_t(1,0);
+    g.m[9]  = complex_t(1,0);
+    g.m[15] = complex_t(1,0);
+    return g;
+}
+
+} // namespace invariantq
diff --git a/core/src/api.cpp b/core/src/api.cpp
new file mode 100644
index 0000000..7e69496
--- /dev/null
+++ b/core/src/api.cpp
@@ -0,0 +1,316 @@
+#include "c_api.h"
+#include "statevector.hpp"
+#include "density_matrix.hpp"
+#include "stabilizer.hpp"
+#include "mps.hpp"
+#include <cstring>
+
+using namespace invariantq;
+
+extern "C" {
+
+// ==================== StateVector ====================
+
+void* iq_statevector_create(size_t num_qubits) {
+    try {
+        return new StateVector(num_qubits);
+    } catch (...) {
+        return nullptr;
+    }
+}
+
+void iq_statevector_free(void* sv) {
+    if (sv) delete static_cast<StateVector*>(sv);
+}
+
+void iq_statevector_reset(void* sv) {
+    if (sv) static_cast<StateVector*>(sv)->reset();
+}
+
+void iq_statevector_apply_1q(void* sv, size_t target, const double* u_real, const double* u_imag) {
+    if (!sv || !u_real || !u_imag) return;
+    complex_t U[4];
+    for (int i = 0; i < 4; ++i) {
+        U[i] = complex_t(u_real[i], u_imag[i]);
+    }
+    static_cast<StateVector*>(sv)->apply_1q_gate(target, U);
+}
+
+void iq_statevector_apply_2q(void* sv, size_t q0, size_t q1, const double* u_real, const double* u_imag) {
+    if (!sv || !u_real || !u_imag) return;
+    complex_t U[16];
+    for (int i = 0; i < 16; ++i) {
+        U[i] = complex_t(u_real[i], u_imag[i]);
+    }
+    static_cast<StateVector*>(sv)->apply_2q_gate(q0, q1, U);
+}
+
+void iq_statevector_apply_fused(void* sv, const size_t* qubits, size_t k, const double* u_real, const double* u_imag) {
+    if (!sv || !qubits || !u_real || !u_imag) return;
+    size_t dim = 1ULL << k;
+    std::vector<complex_t> U(dim * dim);
+    for (size_t i = 0; i < dim * dim; ++i) {
+        U[i] = complex_t(u_real[i], u_imag[i]);
+    }
+    std::vector<size_t> q_vec(qubits, qubits + k);
+    static_cast<StateVector*>(sv)->apply_fused_gate(q_vec, U.data(), k);
+}
+
+int iq_statevector_measure(void* sv, size_t target, double rand_val) {
+    if (!sv) return 0;
+    return static_cast<StateVector*>(sv)->measure(target, rand_val);
+}
+
+void iq_statevector_reset_qubit(void* sv, size_t target, double rand_val) {
+    if (!sv) return;
+    static_cast<StateVector*>(sv)->reset_qubit(target, rand_val);
+}
+
+double iq_statevector_measure_prob(void* sv, size_t target, int outcome) {
+    if (!sv) return 0.0;
+    return static_cast<StateVector*>(sv)->measure_probability(target, outcome);
+}
+
+void iq_statevector_get_amplitudes(void* sv, double* real_out, double* imag_out) {
+    if (!sv || !real_out || !imag_out) return;
+    auto* s = static_cast<StateVector*>(sv);
+    const complex_t* data = s->data();
+    size_t dim = s->dim();
+    for (size_t i = 0; i < dim; ++i) {
+        real_out[i] = data[i].real();
+        imag_out[i] = data[i].imag();
+    }
+}
+
+void iq_statevector_get_probabilities(void* sv, double* probs_out) {
+    if (!sv || !probs_out) return;
+    auto* s = static_cast<StateVector*>(sv);
+    std::vector<double> probs = s->probabilities();
+    std::memcpy(probs_out, probs.data(), probs.size() * sizeof(double));
+}
+
